<Project Sdk="WixToolset.Sdk/5.0.2">

  <PropertyGroup>
    <Platform Condition=" '$(Platform)' == '' ">x64</Platform>
    <!-- Pass /p:Version=x.y.z.w from the build; keep in sync with the app csproj <Version> -->
    <Version Condition=" '$(Version)' == '' ">2.1.0.0</Version>
    <PublishDir Condition=" '$(PublishDir)' == '' ">..\EnvironmentManager4\bin\publish\</PublishDir>
    <!-- AppVersionUtilities.GetLatestVersion parses the version out of this file name -->
    <OutputName>Environment Manager v$(Version)</OutputName>
    <DefineConstants>Version=$(Version);PublishDir=$(PublishDir)</DefineConstants>
    <SuppressValidation>true</SuppressValidation>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="WixToolset.UI.wixext" Version="5.0.2" />
  </ItemGroup>

</Project>
